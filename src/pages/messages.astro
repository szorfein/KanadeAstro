---
import BaseLayout from "../layouts/BaseLayout.astro";
import Guestbook from "../components/Guestbook.vue";
---
<BaseLayout title="Message Wall" description="Pick a colorful sticky note and write greetings, wishes, and today's little happiness. Save every gentle moment on the Kanade message wall." heroTitle="A small wall holds so much tenderness" heroSubtitle="Let passing moods have a place to rest.">
  <div class="shell guestbook-shell"><Guestbook client:load /></div>
</BaseLayout>
<style>
  .guestbook-shell { padding-top: 24px; padding-bottom: 42px; }
  @media (max-width: 760px) { .guestbook-shell { padding-top: 18px; padding-bottom: 28px; } }
</style>
