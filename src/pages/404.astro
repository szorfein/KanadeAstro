---
import { withBase } from "../lib/urls";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="The page is lost" heroTitle="Occasionally getting lost, that's okay" heroSubtitle="Change direction, and you might encounter new scenery.">
  <div class="shell missing-page"><div class="card page-card"><span class="missing-number">404</span><h2>I haven't written this story on this page yet</h2><p>The page might have been moved, or there might be a small typo in the link.</p><a href={withBase("/")} class="btn">Back to the homepage</a><a href={withBase("/posts/")} class="btn secondary">Read Casually</a></div></div>
</BaseLayout>
<style>
.missing-page { padding-top: 25px; padding-bottom: 50px; max-width: 720px; text-align: center; }
.missing-number { font: 85px "Oxanium-Medium"; color: var(--accent); }
.missing-page h2 { font-size: 23px; margin: 8px; }
.missing-page p { color: var(--muted); font-size: 13px; margin: 15px 0 25px; }
.missing-page .btn { margin: 5px; font-size: 13px; }
</style>
